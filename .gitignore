# lichess-bot/config.yml has my Lichess token in it, so the whole lichess-bot folder that
# windows/lichess_bot.bat downloads stays out of the repo. The only config that gets committed is
# deploy/lichess-bot-config.yml, which has a placeholder instead of the real token.
lichess-bot/
*.token
.env

# Model weights: too big for git history; published as GitHub Release assets.
*.onnx
*.onnx.part*
*.pt
models/
maia2_models/

# Game data: regenerated by training/fetch_games.py and training/prep_data.py.
data/
*.pgn

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc

# lichess-bot runtime logs
lichess_bot_auto_logs/
*.log

# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Engine build (engine/build_exe.bat): the .exe is rebuilt, not committed
build/
*.spec
engine/markbot.exe
.venv-engine/
