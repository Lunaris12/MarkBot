# Secrets: the real lichess-bot config holds the Lichess API token.
# Only config.yml.example (with a placeholder) is ever committed.
lichess-bot/config.yml
*.token
.env

# Model weights: too big for git history; published as GitHub Release assets.
*.onnx
*.onnx.part*
*.pt
models/
maia2_models/

# Game data: regenerated by training/fetch_games.py and training/prep_data.py.
data/
*.pgn

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc

# lichess-bot runtime logs
lichess_bot_auto_logs/
*.log

# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Engine build (engine/build_exe.bat): the .exe is rebuilt, not committed
build/
*.spec
engine/markbot.exe
.venv-engine/
